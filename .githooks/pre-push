#!/bin/sh
# Refuse to push commits that credit Claude/Anthropic or have a foreign author (owner rule).
OWNER="mohamedwali98-dotcom"
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  bad=$(git log --format='%H %an <%ae> | %cn <%ce>%n%B' $range | grep -iE 'claude|anthropic')
  if [ -n "$bad" ]; then echo "pre-push: Claude/Anthropic attribution found, push blocked:"; echo "$bad"; exit 1; fi
  foreign=$(git log --format='%an' $range | grep -v "^$OWNER\$")
  if [ -n "$foreign" ]; then echo "pre-push: commit author is not $OWNER: $foreign"; exit 1; fi
done
exit 0
